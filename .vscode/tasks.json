// =============================================================================
// Tasks do workspace eVTOL ITA
// =============================================================================
//
// Ctrl+Shift+P -> "Tasks: Run Task", ou Ctrl+Shift+B para compilar.
//
// As tasks sao agrupadas por prefixo, entao a lista aparece ordenada:
//     build            compilar
//     sim: ...         simulacao
//     voo: ...         coisas de voo real
//     doctor           verificar o ambiente
//
// O BLOCO "inputs" NO FIM DESTE ARQUIVO E GERADO. Nao edite a mao:
//
//     python3 scripts/sync_tasks.py
//
// O VS Code so aceita lista fixa nos campos de entrada, e lista escrita a mao
// envelhece -- a versao anterior oferecia so `sae2026` e `mission_1`, entao
// quem criasse a cbr2026 com a fase1 nao a encontrava aqui. O sincronizador
// deriva as listas do que existe em src/: competicoes (quem tem
// scripts/simulate.sh), mundos (o bloco `case` de cada simulate.sh) e pacotes
// (colcon list). O setup.sh e o new_mission.sh o chamam sozinhos.
//
// O resto do arquivo (as tasks) e escrito a mao e preservado pelo script.
// =============================================================================
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "detail": "Compila um pacote (ou 'all' / 'deps') — Ctrl+Shift+B",
            "type": "shell",
            // A opcao vem como "competicao:alvo"; ${A%%:*} pega a competicao e
            // ${A#*:} pega o alvo. Assim uma escolha so ja diz as duas coisas,
            // e nao existe combinacao invalida.
            "command": "A='${input:alvoBuild}'; bash \"src/${A%%:*}/scripts/build.sh\" \"${A#*:}\"",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": "$gcc",
            "presentation": { "panel": "dedicated", "clear": true }
        },

        {
            "label": "sim: iniciar",
            "detail": "PX4 + Gazebo, agente DDS e ponte de imagem, de uma vez",
            "dependsOn": [ "sim: PX4 + Gazebo", "sim: agente DDS", "sim: ponte de imagem" ],
            "problemMatcher": []
        },
        {
            "label": "sim: iniciar com missão",
            "detail": "O mesmo que 'sim: iniciar', e já sobe a missão junto",
            "dependsOn": [
                "sim: PX4 + Gazebo",
                "sim: agente DDS",
                "sim: ponte de imagem",
                "sim: rodar missão"
            ],
            "problemMatcher": []
        },
        {
            "label": "sim: PX4 + Gazebo",
            "detail": "Sobe o simulador num mundo da competição",
            "type": "shell",
            "command": "M='${input:mundo}'; bash \"src/${M%%:*}/scripts/simulate.sh\" \"${M#*:}\"",
            "problemMatcher": [],
            "presentation": {
                // Sem "group": com ele, o VS Code junta as tasks num unico
                // terminal DIVIDIDO, e com quatro processos falantes ao mesmo
                // tempo nao da para ler nenhum. Sem ele, cada task ganha a
                // propria ABA -- da para alternar e ler uma de cada vez.
                //
                // "dedicated" faz cada task reusar sempre a MESMA aba, em vez
                // de abrir uma nova a cada execucao.
                "panel": "dedicated",
                "clear": true,
                "showReuseMessage": false
            }
        },
        {
            "label": "sim: agente DDS",
            "detail": "Micro XRCE-DDS Agent — ponte PX4 ↔ ROS 2",
            "type": "shell",
            // O agent.sh e igual em todas as competicoes; usamos a do mundo escolhido
            // so para nao precisar de mais uma pergunta.
            "command": "M='${input:mundo}'; bash \"src/${M%%:*}/scripts/agent.sh\"",
            "problemMatcher": [],
            "presentation": {
                // Sem "group": com ele, o VS Code junta as tasks num unico
                // terminal DIVIDIDO, e com quatro processos falantes ao mesmo
                // tempo nao da para ler nenhum. Sem ele, cada task ganha a
                // propria ABA -- da para alternar e ler uma de cada vez.
                //
                // "dedicated" faz cada task reusar sempre a MESMA aba, em vez
                // de abrir uma nova a cada execucao.
                "panel": "dedicated",
                "clear": true,
                "showReuseMessage": false
            }
        },
        {
            "label": "sim: ponte de imagem",
            "detail": "ros_gz_image — câmeras do Gazebo → tópicos ROS 2",
            "type": "shell",
            "command": "bash scripts/image_bridge.sh",
            "problemMatcher": [],
            "presentation": {
                // Sem "group": com ele, o VS Code junta as tasks num unico
                // terminal DIVIDIDO, e com quatro processos falantes ao mesmo
                // tempo nao da para ler nenhum. Sem ele, cada task ganha a
                // propria ABA -- da para alternar e ler uma de cada vez.
                //
                // "dedicated" faz cada task reusar sempre a MESMA aba, em vez
                // de abrir uma nova a cada execucao.
                "panel": "dedicated",
                "clear": true,
                "showReuseMessage": false
            }
        },
        {
            "label": "sim: rodar missão",
            "detail": "ros2 launch <pacote> simulation.launch.py",
            "type": "shell",
            // A opcao vem como "competicao:missao"; o ros2 launch so precisa do
            // nome do pacote, entao descartamos a parte antes do ":".
            "command": "P='${input:pacoteMissao}'; source scripts/ros_env.sh && ros2 launch \"${P#*:}\" simulation.launch.py",
            "problemMatcher": [],
            "presentation": {
                // Sem "group": com ele, o VS Code junta as tasks num unico
                // terminal DIVIDIDO, e com quatro processos falantes ao mesmo
                // tempo nao da para ler nenhum. Sem ele, cada task ganha a
                // propria ABA -- da para alternar e ler uma de cada vez.
                //
                // "dedicated" faz cada task reusar sempre a MESMA aba, em vez
                // de abrir uma nova a cada execucao.
                "panel": "dedicated",
                "clear": true,
                "showReuseMessage": false
            }
        },
        {
            "label": "sim: parar tudo",
            "detail": "Encerra PX4, Gazebo e o agente DDS, e limpa /tmp/px4*",
            "type": "shell",
            // O agente tambem precisa morrer: se ele sobrevive, a proxima
            // simulacao encontra a porta 8888 ocupada e o PX4 nao conecta.
            "command": "pkill -x px4; pkill -f 'gz sim'; pkill -x MicroXRCEAgent; rm -rf /tmp/px4*; echo 'simulação encerrada'",
            "problemMatcher": [],
            "presentation": {
                "panel": "dedicated",
                "reveal": "silent",
                "close": true,
                "showReuseMessage": false
            }
        },

        {
            "label": "doctor",
            "detail": "Confere se esta máquina bate com o perfil de ambiente",
            "type": "shell",
            "command": "./doctor.sh",
            "problemMatcher": [],
            "presentation": { "panel": "dedicated", "clear": true }
        },
        {
            "label": "tasks: sincronizar",
            "detail": "Atualiza as listas destas tasks a partir do que existe em src/",
            "type": "shell",
            "command": "python3 scripts/sync_tasks.py",
            "problemMatcher": [],
            "presentation": { "panel": "dedicated", "clear": true }
        },

        {
            "label": "voo: ground station",
            "detail": "Sobe a estação de solo de uma missão",
            "type": "shell",
            "command": "P='${input:pacoteMissao}'; bash scripts/ground_station.sh \"${P#*:}\"",
            "problemMatcher": []
        },
        {
            "label": "voo: fechar garra",
            "detail": "Aciona o servo da garra (GPIO da Jetson)",
            "type": "shell",
            "command": "bash scripts/fechar_garra.sh",
            "problemMatcher": []
        }
    ],

    "inputs": [
        {
            "id": "mundo",
            "description": "Mundo do Gazebo (competição:mundo)",
            "type": "pickString",
            "options": [
                "cbr2026:default",
                "cbr2026:fase1",
                "cm204-evtol:casa1",
                "sae2026:default",
                "sae2026:sae1",
                "sae2026:sae2",
                "sae2026:sae3"
            ],
            "default": "sae2026:sae1"
        },
        {
            "id": "alvoBuild",
            "description": "O que compilar (competição:alvo)",
            "type": "pickString",
            "options": [
                "cbr2026:all",
                "cbr2026:deps",
                "cbr2026:fase1",
                "cbr2026:fase3",
                "cbr2026:fase4",
                "cm204-evtol:all",
                "cm204-evtol:cbr2025_fase4",
                "cm204-evtol:deps",
                "sae2026:all",
                "sae2026:audio_alert",
                "sae2026:deps",
                "sae2026:mission_1",
                "sae2026:mission_1_H",
                "sae2026:mission_2",
                "sae2026:mission_3",
                "sae2026:mission_teste"
            ],
            "default": "sae2026:all"
        },
        {
            "id": "pacoteMissao",
            "description": "Missão (competição:missão)",
            "type": "pickString",
            "options": [
                "cbr2026:fase1",
                "cbr2026:fase3",
                "cbr2026:fase4",
                "sae2026:mission_1",
                "sae2026:mission_1_H",
                "sae2026:mission_2",
                "sae2026:mission_3",
                "sae2026:mission_teste"
            ],
            "default": "sae2026:mission_1"
        }
    ]
}
