// =============================================================================
// Tasks do workspace eVTOL ITA
// =============================================================================
//
// Ctrl+Shift+P -> "Tasks: Run Task", ou Ctrl+Shift+B para compilar.
//
// As tasks sao agrupadas por prefixo, entao a lista aparece ordenada:
//     build ...        compilar (pacote, all, deps, changed)
//     sim: ...         simulacao no Gazebo
//     sim2d: ...       simulador 2D, sem Gazebo
//     voo: ...         coisas de voo real
//     doctor           verificar o ambiente
//     perfil           qual perfil de ambiente esta valendo aqui
//
// O BLOCO "inputs" NO FIM DESTE ARQUIVO E GERADO. Nao edite a mao:
//
//     python3 scripts/sync_tasks.py
//
// O VS Code so aceita lista fixa nos campos de entrada, e lista escrita a mao
// envelhece -- a versao anterior oferecia so `sae2026` e `mission_1`, entao
// quem criasse a cbr2026 com a fase1 nao a encontrava aqui. O sincronizador
// deriva as listas do que existe em src/: competicoes (quem tem
// scripts/simulate.sh), mundos (o bloco `case` de cada simulate.sh) e pacotes
// (colcon list). O setup.sh e o new_mission.sh o chamam sozinhos.
//
// O resto do arquivo (as tasks) e escrito a mao e preservado pelo script.
// =============================================================================
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "detail": "Compila um pacote, ou all / deps / changed — Ctrl+Shift+B",
            "type": "shell",
            // O alvo e o NOME DO PACOTE, sem prefixo de competicao.
            //
            // Antes era "competicao:alvo", e isso escondia duas coisas. Pacote
            // que nao pertence a competicao nenhuma nao aparecia na lista --
            // camera_publisher, cv_nodes, drone_lib, stdstates, justamente os
            // que mais se mexe. E `all` fazia a mesma coisa nos quatro
            // prefixos, porque todos os build.sh rodam colcon sobre o src/
            // inteiro: `cbr2026:all` e `sae2026:all` eram o mesmo comando.
            "command": "bash scripts/build.sh '${input:alvoBuild}'",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": "$gcc",
            "presentation": { "panel": "dedicated", "clear": true }
        },
        {
            "label": "build: pacote (digitado)",
            "detail": "Compila o(s) pacote(s) que você digitar — aceita vários",
            "type": "shell",
            // A lista suspensa so conhece o que existia na ultima sincronizacao.
            // Quem acabou de criar uma missao e exatamente quem precisa
            // compila-la, e nao deveria ter que rodar o sincronizador antes.
            "command": "bash scripts/build.sh ${input:pacotesDigitados}",
            "group": "build",
            "problemMatcher": "$gcc",
            "presentation": { "panel": "dedicated", "clear": true }
        },
        {
            "label": "build: só este pacote (sem dependências)",
            "detail": "--packages-select: recompila só ele, para o ciclo curto",
            "type": "shell",
            // --packages-up-to (o padrao) reconstroi a cadeia inteira de
            // dependencias. Quando se mexeu num .py de um pacote so, isso e
            // esperar minutos por nada.
            "command": "bash scripts/build.sh --select '${input:alvoBuild}'",
            "group": "build",
            "problemMatcher": "$gcc",
            "presentation": { "panel": "dedicated", "clear": true }
        },

        {
            "label": "sim: iniciar",
            "detail": "PX4 + Gazebo, agente DDS e ponte de imagem, de uma vez",
            "dependsOn": [ "sim: PX4 + Gazebo", "sim: agente DDS", "sim: ponte de imagem" ],
            "problemMatcher": []
        },
        {
            "label": "sim: iniciar com missão",
            "detail": "O mesmo que 'sim: iniciar', e já sobe a missão junto",
            // POR QUE NAO HA "dependsOrder": "sequence" AQUI
            //
            // Parece a correcao obvia para a ordem de subida, e nao e: o VS
            // Code espera cada task TERMINAR antes de comecar a proxima, e
            // PX4, Gazebo e agente nao terminam -- ficam rodando. Com
            // "sequence" a cadeia trava na primeira e a missao nunca sobe.
            "dependsOn": [
                "sim: PX4 + Gazebo",
                "sim: agente DDS",
                "sim: ponte de imagem",
                "sim: rodar missão"
            ],
            "problemMatcher": []
        },
        {
            "label": "sim: PX4 + Gazebo",
            "detail": "Sobe o PX4 SITL com o mundo escolhido",
            "type": "shell",
            // A opcao vem como "competicao:mundo"; ${M%%:*} pega a competicao e
            // ${M#*:} pega o mundo. Assim uma escolha so ja diz as duas coisas,
            // e nao existe combinacao invalida.
            "command": "M='${input:mundo}'; bash \"src/${M%%:*}/scripts/simulate.sh\" \"${M#*:}\"",
            "problemMatcher": [],
            "presentation": {
                // Sem "group": com ele, o VS Code junta as tasks num unico
                // terminal DIVIDIDO, e com quatro processos falantes ao mesmo
                // tempo nao da para ler nenhum. Sem ele, cada task ganha a
                // propria ABA -- da para alternar e ler uma de cada vez.
                //
                // "dedicated" faz cada task reusar sempre a MESMA aba, em vez
                // de abrir uma nova a cada execucao.
                "panel": "dedicated",
                "clear": true,
                "showReuseMessage": false
            }
        },
        {
            "label": "sim: agente DDS",
            "detail": "Micro XRCE-DDS Agent — a ponte entre o PX4 e o ROS 2",
            "type": "shell",
            // ESTA TASK NAO PERGUNTA O MUNDO, E ESSE E O PONTO.
            //
            // Ela chamava "src/${M%%:*}/scripts/agent.sh", usando o mundo so
            // para escolher de qual competicao pegar o script -- e os agent.sh
            // das competicoes eram byte a byte identicos. O preco era alto e
            // invisivel: o VS Code resolve os inputs POR TASK, entao um
            // dependsOn com duas tasks citando ${input:mundo} perguntava o
            // mundo DUAS VEZES ao subir uma simulacao.
            //
            // Com um agent.sh na raiz, a pergunta some. "sim: iniciar" pergunta
            // uma vez; "sim: iniciar com missão", duas -- mundo e missao, que
            // sao perguntas de verdade e diferentes entre si.
            "command": "bash scripts/agent.sh",
            "problemMatcher": [],
            "presentation": {
                "panel": "dedicated",
                "clear": true,
                "showReuseMessage": false
            }
        },
        {
            "label": "sim: ponte de imagem",
            "detail": "ros_gz_image — câmeras do Gazebo → tópicos ROS 2",
            "type": "shell",
            "command": "bash scripts/image_bridge.sh",
            "problemMatcher": [],
            "presentation": {
                "panel": "dedicated",
                "clear": true,
                "showReuseMessage": false
            }
        },
        {
            "label": "sim: rodar missão",
            "detail": "ros2 launch <pacote> simulation.launch.py",
            "type": "shell",
            // A opcao vem como "competicao:missao"; o ros2 launch so precisa do
            // nome do pacote, entao descartamos a parte antes do ":".
            "command": "P='${input:pacoteMissao}'; source scripts/ros_env.sh && ros2 launch \"${P#*:}\" simulation.launch.py",
            "problemMatcher": [],
            "presentation": {
                "panel": "dedicated",
                "clear": true,
                "showReuseMessage": false
            }
        },
        {
            "label": "sim: parar tudo",
            "detail": "Encerra a simulação INTEIRA — e confere que encerrou",
            "type": "shell",
            // O que estava aqui era: pkill -x px4; pkill -f 'gz sim';
            // pkill -x MicroXRCEAgent; rm -rf /tmp/px4*.
            //
            // Tres processos, de um total muito maior. A ponte de imagem, os
            // nos da missao, o sim2d, a estacao de solo e o rosbag ficavam de
            // pe -- e a rodada seguinte subia por cima deles, com dois
            // publicadores no mesmo topico. O sistema responde, com dados de
            // antes, e ninguem desconfia.
            //
            // O script tambem manda SIGINT antes de SIGKILL (um rosbag morto a
            // KILL nao fecha o arquivo) e sai com erro se sobrou algo.
            "command": "bash scripts/parar.sh",
            "problemMatcher": [],
            "presentation": {
                "panel": "dedicated",
                "reveal": "always",
                "showReuseMessage": false
            }
        },

        {
            "label": "sim2d: rodar uma fase",
            "detail": "Simulador 2D + missão, sem Gazebo — segundos em vez de minutos",
            "type": "shell",
            // UMA task, e nao duas com dependsOn.
            //
            // Eram "sim2d: simulador" e "sim2d: missão", e as duas citavam
            // ${input:pacoteMissao}. Como o VS Code resolve os inputs por task,
            // ele perguntava QUAL FASE duas vezes para rodar uma. O sim2d.sh
            // agora sobe as duas coisas, na ordem certa, e derruba a missao
            // junto no fim -- o que o `sleep 3` da task antiga nao garantia.
            "command": "P='${input:pacoteMissao}'; bash scripts/sim2d.sh \"${P#*:}\" --com-missao",
            "problemMatcher": [],
            "presentation": {
                "panel": "dedicated", "clear": true, "showReuseMessage": false
            }
        },

        {
            "label": "doctor",
            "detail": "Confere se esta máquina bate com o perfil de ambiente",
            "type": "shell",
            "command": "./doctor.sh",
            "problemMatcher": [],
            "presentation": { "panel": "dedicated", "clear": true }
        },
        {
            "label": "perfil",
            "detail": "Qual perfil de ambiente esta máquina está usando",
            "type": "shell",
            // Dava para listar os perfis e para escolher um, e nao dava para
            // perguntar em qual voce esta. Numa equipe com Jetson (Humble) e
            // Raspberry (Jazzy) ao mesmo tempo, e a mesma pergunta que "em que
            // maquina eu estou" -- e ela aparece quando algo se comporta de
            // forma inesperada, que e a pior hora para ter de abrir um arquivo
            // escondido para descobrir.
            "command": "./doctor.sh --current && echo && ./doctor.sh --list",
            "problemMatcher": [],
            "presentation": { "panel": "dedicated", "clear": true }
        },
        {
            "label": "tasks: sincronizar",
            "detail": "Atualiza as listas destas tasks a partir do que existe em src/",
            "type": "shell",
            "command": "python3 scripts/sync_tasks.py",
            "problemMatcher": [],
            "presentation": { "panel": "dedicated", "clear": true }
        },

        {
            "label": "voo: pré-voo",
            "detail": "Com a missão no ar: confere o sistema RODANDO antes de armar",
            "type": "shell",
            // O docs/CONTRATOS.md garante que o codigo e a documentacao
            // concordam. Esta task pega o caso em que os dois concordam e A
            // MAQUINA faz outra coisa: o topico que ninguem publica, o QoS que
            // nao casa, o intrinseco que continua sendo placeholder. Nenhuma
            // dessas falhas imprime erro; todas produzem um sistema que sobe,
            // nao reclama, e voa cego.
            "command": "P='${input:pacoteMissao}'; bash scripts/preflight.sh \"${P#*:}\"",
            "problemMatcher": [],
            "presentation": { "panel": "dedicated", "clear": true }
        },
        {
            "label": "contratos: atualizar",
            "detail": "Regenera o docs/CONTRATOS.md a partir do código",
            "type": "shell",
            "command": "python3 scripts/contratos.py",
            "problemMatcher": [],
            "presentation": { "panel": "dedicated", "clear": true }
        },
        {
            "label": "voo: QGroundControl",
            "detail": "Abre o QGC — procura o AppImage onde quer que ele esteja",
            "type": "shell",
            // Sem caminho fixo: o AppImage tem 180 MB, nao entra no
            // repositorio, e cada maquina o guardou num lugar diferente. O
            // script procura, e quem quiser fixar usa a chave `qgc.path` do
            // perfil da maquina -- que e o manifesto de onde ESTA maquina
            // guarda as coisas.
            "command": "bash scripts/qgc.sh",
            "problemMatcher": [],
            "presentation": { "panel": "dedicated", "reveal": "silent" }
        },
        {
            "label": "voo: ground station",
            "detail": "Sobe a estação de solo de uma missão",
            "type": "shell",
            // Usa ${input:pacoteGround}, e nao ${input:pacoteMissao}.
            //
            // A lista das missoes tinha dez opcoes e NENHUMA delas com um
            // launch de solo -- as dez falhavam igual, com um "launch file not
            // found" que parecia problema de compilacao. O pacoteGround e
            // derivado de quem TEM o launch, entao a escolha errada deixa de
            // existir.
            "command": "bash scripts/ground_station.sh '${input:pacoteGround}'",
            "problemMatcher": [],
            "presentation": { "panel": "dedicated", "clear": true }
        },
        {
            "label": "voo: fechar garra",
            "detail": "Aciona o servo da garra (GPIO da Jetson)",
            "type": "shell",
            "command": "bash scripts/fechar_garra.sh",
            "problemMatcher": [],
            "presentation": { "panel": "dedicated", "clear": true }
        }
    ],

    "inputs": [
        {
            "id": "mundo",
            "description": "Mundo do Gazebo (competição:mundo)",
            "type": "pickString",
            "options": [
                "cbr2026:default",
                "cbr2026:fase1",
                "cbr2026:fase4",
                "cm204-evtol:casa1",
                "ensaio_em_voo:default",
                "sae2026:default",
                "sae2026:sae1",
                "sae2026:sae2",
                "sae2026:sae3"
            ],
            "default": "sae2026:sae1"
        },
        {
            "id": "alvoBuild",
            "description": "O que compilar (pacote, ou all/deps/changed)",
            "type": "pickString",
            "options": [
                "all",
                "deps",
                "changed",
                "RDPformas",
                "audio_alert",
                "ball_detector",
                "base_detector",
                "bouncing_detector",
                "camera_calibrator",
                "camera_publisher",
                "custom_msgs",
                "detector",
                "drone_lib",
                "fase1",
                "fase3",
                "fase4",
                "fsm",
                "fsm_demo",
                "geofig_detector",
                "gesture_detector",
                "mangueira_detector",
                "manometro_detector",
                "maze_geometry",
                "mission_1",
                "mission_1_H",
                "mission_2",
                "mission_3",
                "mission_teste",
                "number_detector",
                "ozzy_bridge",
                "qrcode_detector",
                "sim2d",
                "stdbt",
                "stdstates",
                "telemetry_handler",
                "teste_grid_quadrado",
                "teste_yaw",
                "vision_geometry",
                "window_detector",
                "behaviortree_cpp",
                "cbr2025_fase4",
                "example_global_navigation_cpp",
                "example_local_navigation_cpp",
                "example_mode_fw_attitude_cpp",
                "example_mode_goto_cpp",
                "example_mode_goto_global_cpp",
                "example_mode_manual_cpp",
                "example_mode_rtl_replacement_cpp",
                "example_mode_with_executor_cpp",
                "itajuba_cv_utils",
                "itajuba_drone_lib",
                "itajuba_fase1",
                "itajuba_fase2",
                "itajuba_fase3",
                "itajuba_fase4",
                "itajuba_telemetry_handler",
                "px4_msgs",
                "px4_ros2_cpp",
                "sae_cv_utils",
                "sae_drone_lib",
                "sae_fase1",
                "sae_fase2",
                "sae_fase3"
            ],
            "default": "changed"
        },
        {
            "id": "pacoteMissao",
            "description": "Missão (competição:missão)",
            "type": "pickString",
            "options": [
                "cbr2026:fase1",
                "cbr2026:fase3",
                "cbr2026:fase4",
                "ensaio_em_voo:teste_grid_quadrado",
                "ensaio_em_voo:teste_yaw",
                "sae2026:mission_1",
                "sae2026:mission_1_H",
                "sae2026:mission_2",
                "sae2026:mission_3",
                "sae2026:mission_teste"
            ],
            "default": "sae2026:mission_1"
        },
        {
            "id": "pacoteGround",
            "description": "Estação de solo (pacote)",
            "type": "pickString",
            "options": [
                "fase3"
            ],
            "default": "fase3"
        },
        {
            "id": "pacotesDigitados",
            "description": "Pacote(s) a compilar, separados por espaço",
            "type": "promptString",
            "default": ""
        }
    ]
}
