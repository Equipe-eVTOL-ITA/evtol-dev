// =============================================================================
// Tasks do workspace eVTOL ITA
// =============================================================================
//
// Ctrl+Shift+P -> "Tasks: Run Task", ou Ctrl+Shift+B para compilar.
//
// As tasks sao agrupadas por prefixo, entao a lista aparece ordenada:
//     build            compilar
//     sim: ...         simulacao
//     voo: ...         coisas de voo real
//     doctor           verificar o ambiente
//
// O BLOCO "inputs" NO FIM DESTE ARQUIVO E GERADO. Nao edite a mao:
//
//     python3 scripts/sync_tasks.py
//
// O VS Code so aceita lista fixa nos campos de entrada, e lista escrita a mao
// envelhece -- a versao anterior oferecia so `sae2026` e `mission_1`, entao
// quem criasse a cbr2026 com a fase1 nao a encontrava aqui. O sincronizador
// deriva as listas do que existe em src/: competicoes (quem tem
// scripts/simulate.sh), mundos (o bloco `case` de cada simulate.sh) e pacotes
// (colcon list). O setup.sh e o new_mission.sh o chamam sozinhos.
//
// O resto do arquivo (as tasks) e escrito a mao e preservado pelo script.
// =============================================================================
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "detail": "Compila um pacote (ou 'all' / 'deps') — Ctrl+Shift+B",
            "type": "shell",
            // A opcao vem como "competicao:alvo"; ${A%%:*} pega a competicao e
            // ${A#*:} pega o alvo. Assim uma escolha so ja diz as duas coisas,
            // e nao existe combinacao invalida.
            "command": "A='${input:alvoBuild}'; bash \"src/${A%%:*}/scripts/build.sh\" \"${A#*:}\"",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": "$gcc",
            "presentation": { "panel": "dedicated", "clear": true }
        },

        {
            "label": "sim: iniciar",
            "detail": "PX4 + Gazebo, agente DDS e ponte de imagem, de uma vez",
            "dependsOn": [ "sim: PX4 + Gazebo", "sim: agente DDS", "sim: ponte de imagem" ],
            "problemMatcher": []
        },
        {
            "label": "sim: iniciar com missão",
            "detail": "O mesmo que 'sim: iniciar', e já sobe a missão junto",
            "dependsOn": [
                "sim: PX4 + Gazebo",
                "sim: agente DDS",
                "sim: ponte de imagem",
                "sim: rodar missão"
            ],
            "problemMatcher": []
        },
        {
            "label": "sim: PX4 + Gazebo",
            "detail": "Sobe o simulador num mundo da competição",
            "type": "shell",
            "command": "M='${input:mundo}'; bash \"src/${M%%:*}/scripts/simulate.sh\" \"${M#*:}\"",
            "problemMatcher": [],
            "presentation": {
                // Sem "group": com ele, o VS Code junta as tasks num unico
                // terminal DIVIDIDO, e com quatro processos falantes ao mesmo
                // tempo nao da para ler nenhum. Sem ele, cada task ganha a
                // propria ABA -- da para alternar e ler uma de cada vez.
                //
                // "dedicated" faz cada task reusar sempre a MESMA aba, em vez
                // de abrir uma nova a cada execucao.
                "panel": "dedicated",
                "clear": true,
                "showReuseMessage": false
            }
        },
        {
            "label": "sim: agente DDS",
            "detail": "Micro XRCE-DDS Agent — ponte PX4 ↔ ROS 2",
            "type": "shell",
            // O agent.sh e igual em todas as competicoes; usamos a do mundo escolhido
            // so para nao precisar de mais uma pergunta.
            "command": "M='${input:mundo}'; bash \"src/${M%%:*}/scripts/agent.sh\"",
            "problemMatcher": [],
            "presentation": {
                // Sem "group": com ele, o VS Code junta as tasks num unico
                // terminal DIVIDIDO, e com quatro processos falantes ao mesmo
                // tempo nao da para ler nenhum. Sem ele, cada task ganha a
                // propria ABA -- da para alternar e ler uma de cada vez.
                //
                // "dedicated" faz cada task reusar sempre a MESMA aba, em vez
                // de abrir uma nova a cada execucao.
                "panel": "dedicated",
                "clear": true,
                "showReuseMessage": false
            }
        },
        {
            "label": "sim: ponte de imagem",
            "detail": "ros_gz_image — câmeras do Gazebo → tópicos ROS 2",
            "type": "shell",
            "command": "bash scripts/image_bridge.sh",
            "problemMatcher": [],
            "presentation": {
                // Sem "group": com ele, o VS Code junta as tasks num unico
                // terminal DIVIDIDO, e com quatro processos falantes ao mesmo
                // tempo nao da para ler nenhum. Sem ele, cada task ganha a
                // propria ABA -- da para alternar e ler uma de cada vez.
                //
                // "dedicated" faz cada task reusar sempre a MESMA aba, em vez
                // de abrir uma nova a cada execucao.
                "panel": "dedicated",
                "clear": true,
                "showReuseMessage": false
            }
        },
        {
            "label": "sim: rodar missão",
            "detail": "ros2 launch <pacote> simulation.launch.py",
            "type": "shell",
            // A opcao vem como "competicao:missao"; o ros2 launch so precisa do
            // nome do pacote, entao descartamos a parte antes do ":".
            "command": "P='${input:pacoteMissao}'; source scripts/ros_env.sh && ros2 launch \"${P#*:}\" simulation.launch.py",
            "problemMatcher": [],
            "presentation": {
                // Sem "group": com ele, o VS Code junta as tasks num unico
                // terminal DIVIDIDO, e com quatro processos falantes ao mesmo
                // tempo nao da para ler nenhum. Sem ele, cada task ganha a
                // propria ABA -- da para alternar e ler uma de cada vez.
                //
                // "dedicated" faz cada task reusar sempre a MESMA aba, em vez
                // de abrir uma nova a cada execucao.
                "panel": "dedicated",
                "clear": true,
                "showReuseMessage": false
            }
        },
        {
            "label": "sim: parar tudo",
            "detail": "Encerra PX4, Gazebo e o agente DDS, e limpa /tmp/px4*",
            "type": "shell",
            // O agente tambem precisa morrer: se ele sobrevive, a proxima
            // simulacao encontra a porta 8888 ocupada e o PX4 nao conecta.
            "command": "pkill -x px4; pkill -f 'gz sim'; pkill -x MicroXRCEAgent; rm -rf /tmp/px4*; echo 'simulação encerrada'",
            "problemMatcher": [],
            "presentation": {
                "panel": "dedicated",
                "reveal": "silent",
                "close": true,
                "showReuseMessage": false
            }
        },

        {
            "label": "sim2d: rodar uma fase",
            "detail": "Simulador 2D + missão, sem Gazebo — segundos em vez de minutos",
            "dependsOn": [ "sim2d: simulador", "sim2d: missão" ],
            "problemMatcher": []
        },
        {
            "label": "sim2d: simulador",
            "detail": "O simulador 2D, configurado pelo config da própria fase",
            "type": "shell",
            // O mapa e a pose inicial saem do config/simulation.yaml da fase, e
            // nao desta linha. Digita-los aqui criaria uma segunda copia deles,
            // e a divergencia nao da erro: da um drone que comeca a missao
            // acreditando estar noutro lugar.
            "command": "P='${input:pacoteMissao}'; bash scripts/sim2d.sh \"${P#*:}\"",
            "problemMatcher": [],
            "presentation": {
                "panel": "dedicated", "clear": true, "showReuseMessage": false
            }
        },
        {
            "label": "sim2d: missão",
            "detail": "A missão, falando com o simulador 2D em vez do Gazebo",
            "type": "shell",
            // Sem o launch: ele subiria rosbag e system_health, que aqui so
            // atrapalham. O binario da missao e o MESMO que vai para o Gazebo e
            // para o drone -- e esse e o ponto do simulador.
            "command": "P='${input:pacoteMissao}'; source scripts/ros_env.sh && sleep 3 && ros2 run \"${P#*:}\" \"${P#*:}\" --ros-args --params-file \"$(ros2 pkg prefix ${P#*:})/share/${P#*:}/config/simulation.yaml\" -p groot2_port:=0.0",
            "problemMatcher": [],
            "presentation": {
                "panel": "dedicated", "clear": true, "showReuseMessage": false
            }
        },

        {
            "label": "fase4: Gazebo completo",
            "detail": "Mundo + PX4 + agente DDS + ponte do LIDAR + missão, de uma vez",
            // Duas etapas, e a ordem importa: o mundo e REGERADO ANTES de o
            // Gazebo subir. Se o mapa mudou e o .sdf nao, o drone voa num
            // labirinto diferente do que a missao acredita, e nada acusa.
            //
            // A geracao entra em SEQUENCIA porque ela TERMINA. Os tres
            // processos de simulacao ficam de pe para sempre, e por isso vao
            // juntos numa etapa PARALELA -- um `sequence` com eles travaria no
            // primeiro, esperando um fim que nunca chega.
            "dependsOrder": "sequence",
            "dependsOn": [ "fase4: gerar o mundo", "fase4: subir a simulação" ],
            "problemMatcher": []
        },
        {
            "label": "fase4: subir a simulação",
            "detail": "Os três processos que ficam de pé, em paralelo",
            "dependsOn": [
                "fase4: PX4 + Gazebo",
                "fase4: agente DDS",
                "fase4: missão + ponte do LIDAR"
            ],
            "problemMatcher": []
        },
        {
            "label": "fase4: gerar o mundo",
            "detail": "Deriva o labirinto do MESMO YAML que a missão lê",
            "type": "shell",
            "command": "source scripts/ros_env.sh && ros2 run sim2d gerar_sdf fase4:cbr2026_fase4.yaml --modelo --nome labirinto_fase4 -o ~/PX4-gazebo-models/models/labirinto_fase4/model.sdf",
            "problemMatcher": [],
            "presentation": { "panel": "dedicated", "reveal": "silent", "close": true }
        },
        {
            "label": "fase4: PX4 + Gazebo",
            "detail": "SITL no mundo da fase 4, com o drone wanda",
            "type": "shell",
            "command": "bash src/cbr2026/scripts/simulate.sh fase4",
            "problemMatcher": [],
            "presentation": {
                "panel": "dedicated", "clear": true, "showReuseMessage": false
            }
        },
        {
            "label": "fase4: agente DDS",
            "detail": "Micro XRCE-DDS Agent — ponte PX4 ↔ ROS 2",
            "type": "shell",
            "command": "bash src/cbr2026/scripts/agent.sh",
            "problemMatcher": [],
            "presentation": {
                "panel": "dedicated", "clear": true, "showReuseMessage": false
            }
        },
        {
            "label": "fase4: missão + ponte do LIDAR",
            "detail": "gazebo.launch.py — a ponte gz→ROS do /scan, o bag e a missão",
            "type": "shell",
            "command": "source scripts/ros_env.sh && ros2 launch fase4 gazebo.launch.py",
            "problemMatcher": [],
            "presentation": {
                "panel": "dedicated", "clear": true, "showReuseMessage": false
            }
        },

        {
            "label": "doctor",
            "detail": "Confere se esta máquina bate com o perfil de ambiente",
            "type": "shell",
            "command": "./doctor.sh",
            "problemMatcher": [],
            "presentation": { "panel": "dedicated", "clear": true }
        },
        {
            "label": "tasks: sincronizar",
            "detail": "Atualiza as listas destas tasks a partir do que existe em src/",
            "type": "shell",
            "command": "python3 scripts/sync_tasks.py",
            "problemMatcher": [],
            "presentation": { "panel": "dedicated", "clear": true }
        },

        {
            "label": "voo: ground station",
            "detail": "Sobe a estação de solo de uma missão",
            "type": "shell",
            "command": "P='${input:pacoteMissao}'; bash scripts/ground_station.sh \"${P#*:}\"",
            "problemMatcher": []
        },
        {
            "label": "voo: fechar garra",
            "detail": "Aciona o servo da garra (GPIO da Jetson)",
            "type": "shell",
            "command": "bash scripts/fechar_garra.sh",
            "problemMatcher": []
        }
    ],

    "inputs": [
        {
            "id": "mundo",
            "description": "Mundo do Gazebo (competição:mundo)",
            "type": "pickString",
            "options": [
                "cbr2026:default",
                "cbr2026:fase1",
                "cbr2026:fase4",
                "cm204-evtol:casa1",
                "ensaio_em_voo:default",
                "sae2026:default",
                "sae2026:sae1",
                "sae2026:sae2",
                "sae2026:sae3"
            ],
            "default": "sae2026:sae1"
        },
        {
            "id": "alvoBuild",
            "description": "O que compilar (competição:alvo)",
            "type": "pickString",
            "options": [
                "cbr2026:all",
                "cbr2026:deps",
                "cbr2026:fase1",
                "cbr2026:fase3",
                "cbr2026:fase4",
                "cm204-evtol:all",
                "cm204-evtol:cbr2025_fase4",
                "cm204-evtol:deps",
                "ensaio_em_voo:all",
                "ensaio_em_voo:deps",
                "ensaio_em_voo:teste_grid_quadrado",
                "ensaio_em_voo:teste_yaw",
                "sae2026:all",
                "sae2026:audio_alert",
                "sae2026:deps",
                "sae2026:mission_1",
                "sae2026:mission_1_H",
                "sae2026:mission_2",
                "sae2026:mission_3",
                "sae2026:mission_teste"
            ],
            "default": "sae2026:all"
        },
        {
            "id": "pacoteMissao",
            "description": "Missão (competição:missão)",
            "type": "pickString",
            "options": [
                "cbr2026:fase1",
                "cbr2026:fase3",
                "cbr2026:fase4",
                "ensaio_em_voo:teste_grid_quadrado",
                "ensaio_em_voo:teste_yaw",
                "sae2026:mission_1",
                "sae2026:mission_1_H",
                "sae2026:mission_2",
                "sae2026:mission_3",
                "sae2026:mission_teste"
            ],
            "default": "sae2026:mission_1"
        }
    ]
}
