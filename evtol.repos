# Workspace manifest for the eVTOL ITA ROS 2 workspace.
#
# Usage (from the workspace root, e.g. ~/evtol/dev):
#   vcs import src < src/evtol-dev/evtol.repos
#
# Every entry MUST pin to a tag (or commit hash), never a branch — pinning to
# a branch reintroduces the "whatever is checked out right now" problem this
# manifest exists to solve. See ARCHITECTURE.md ("Versioning policy").
#
# Non-ROS prerequisites (PX4-Autopilot, Micro-XRCE-DDS-Agent, PX4-gazebo-models)
# are NOT listed here — they live outside the colcon workspace. Their pinned
# versions are documented in SETUP.md.

repositories:

  # ---------- Layer 0: shared message/service interfaces ----------
  custom_msgs:
    type: git
    url: https://github.com/Equipe-eVTOL-ITA/custom_msgs.git
    version: v0.1.0

  # ---------- Layer 1: PX4 hardware abstraction ----------
  drone_lib:
    type: git
    url: https://github.com/Equipe-eVTOL-ITA/drone_lib.git
    version: v0.3.0   # remove a API de gestos, que estava morta
    # A v0.2.0 declara getHandGestures(), getHandLocation() e resetHands(), mas
    # as inscricoes nos topicos nunca eram criadas: as chamadas
    # create_subscription se perderam entre 2025 e 2026. Os getters devolviam
    # {"", ""} e {0.5, 0.5} para sempre, entao uma missao de gestos construida
    # sobre eles compilava, subia e nunca via um gesto. Ninguem no manifesto as
    # usava. A leitura de visao passa a morar num no da missao, com mutex.
    #
    # A v0.1.0 exige cv_bridge no CMakeLists sem declara-lo no package.xml e
    # sem usa-lo em lugar nenhum. Numa imagem minima -- e numa Jetson ou
    # Raspberry recem-instalada -- o build falha, e o rosdep nao pode ajudar
    # porque a dependencia nao esta declarada. O CI do stdstates reprovava
    # por causa disso, ao compilar o drone_lib pinado.

  # ---------- Layer 2: perception ----------
  camera_publisher:
    type: git
    url: https://github.com/Equipe-eVTOL-ITA/camera_publisher.git
    version: v0.1.1   # deps de pip movidas para env/<perfil>.yaml
  cv_nodes:
    type: git
    url: https://github.com/Equipe-eVTOL-ITA/cv_nodes.git
    version: v0.3.1   # imagem de debug util no gesture_detector
    # A v0.3.0 so desenhava a anotacao quando havia mao, e um quadro limpo e
    # ambiguo entre "nao vejo mao" e "nao chegou quadro nenhum". A v0.3.1
    # mostra contador de quadros, "SEM MAO" em vermelho, e o centroide ligado a
    # mira do centro -- o ponto que os PIDs perseguem.
    #
    # A v0.3.0 acrescentou o gesture_detector
    # Reconhecimento de gestos por MediaPipe sobre a classe Detector. O
    # gesture_classifier de 2025 fica no repositorio antigo: o modelo de 8 MB
    # nao era instalado (so funcionava com --symlink-install), o indice da lista
    # de gestos nao identificava a mao, e a posicao da mao so saia com
    # Open_Palm, ou seja, parava exatamente durante o controle.
    #
    # A v0.2.1 deu modulo Python unico ao base_detector
    # A v0.2.0 nomeia o modulo interno do base_detector como `base_detector`,
    # igual ao pacote. O console script e inequivoco, mas o import dentro dele
    # resolve pelo PYTHONPATH, e o itajuba_cv_utils -- que NAO esta neste
    # manifesto, mas esta no src/ das maquinas do time -- expoe um modulo de
    # topo com o mesmo nome e vence. O `ros2 run base_detector base_detector`
    # subia OUTRO detector, sem erro nenhum, e a fase 1 varria a arena inteira
    # sem ver base nenhuma.
    #
    # A v0.1.2 traz o base_detector como esqueleto quebrado: um script solto
    # que lia base.png do disco, sem no ROS, sem dependencias declaradas e com
    # o entry point apontando para um main() inexistente. Compilava.
    #
    # A v0.1.1 nao funciona com o OpenCV 4.11.0.86 pinado em
    # env/desktop-humble.yaml: usa aruco.DetectorParameters_create e
    # aruco.detectMarkers, funcoes livres que nao existem nessa versao.

  vision_geometry:
    type: git
    url: https://github.com/Equipe-eVTOL-ITA/vision_geometry.git
    version: v0.1.1   # guardas contra erro de escala no PnP
    # A v0.1.0 aceita qualquer resultado do PnP. Uma base saindo do quadro
    # encolhe na imagem, e o PnP le isso como distancia maior: medido em SITL,
    # uma caixa de 63 px produziu um alvo a 6,6 m e dez metros ABAIXO do solo.
    # A missao perseguia esse fantasma para fora da arena, sem erro nenhum.
    #
    # Projecao pixel -> mundo, header-only e SEM ROS: so OpenCV e Eigen. Em
    # 2025 esta matematica vivia dentro do no ROS de cada fase (493 linhas
    # replicadas em quatro), o que a tornava impossivel de testar sem subir
    # simulacao e julgar a olho. Erro de sinal em referencial nao parece
    # errado a olho: parece controle mal sintonizado.

  # ---------- Layer 4: behavior ----------
  fsm:
    type: git
    url: https://github.com/Equipe-eVTOL-ITA/fsm.git
    version: v0.2.0   # ciclo de vida do State publico
    # Na v0.1.0, act/on_enter/on_exit sao privados com `friend class FSM`: so a
    # FSM pode executar um estado, e nenhum outro executor pode existir. O stdbt
    # precisa executar os mesmos estados como acoes de Behavior Tree.
    #
    # As derivadas costumam declarar act e on_enter como publicas ao
    # sobrescrever, entao um adaptador as alcancava -- mas NENHUM dos treze
    # estados do stdstates sobrescreve on_exit, e ali o nome resolvia para a
    # base privada. O adaptador compilava para uns estados e nao para outros.
  stdstates:
    type: git
    url: https://github.com/Equipe-eVTOL-ITA/stdstates.git
    version: v0.3.0   # YawSweep, LandAndDisarm, pouso da altura real
    # YawSweepState varre um setor em guinada usando a diferenca NORMALIZADA em
    # relacao ao centro; a versao de 2025 usava limites absolutos e girava sem
    # parar quando o setor cruzava a descontinuidade em pi.
    #
    # LandAndDisarmState pousa e desarma sem bloquear o executor, ao contrario
    # do land() + disarmSync() que 2025 fazia dentro de um on_exit.
    #
    # PrecisionLandingState passa a MEDIR a altura de partida em vez de le-la do
    # YAML. align_height deixa de ser lido -- a fase 1 pode remove-lo do config,
    # e vale revalida-la, porque o pouso passa a partir da altitude real.
    #
    # A v0.2.1 fez o TakeoffState nao reancorar o referencial na redecolagem
    # Na v0.2.0 o TakeoffState chama setHomePosition sempre, movendo a origem do
    # mundo para a posicao atual. Toda missao que pousa e redecola perde as
    # coordenadas ja guardadas -- bases visitadas, grade, casa -- sem erro
    # nenhum, e volta a pousar na mesma base. A v0.2.1 poe isso atras de uma
    # flag cujo padrao preserva o comportamento antigo.
    #
    # A v0.2.0 acrescentou WaypointList, PrecisionAlign, PrecisionLanding e
    # ReturnHome. A v0.1.1 corrigiu a chave rosdep do Eigen (Eigen3 -> eigen) e
    # continua valida para quem so precisa de arming/takeoff/goto.

  # ---------- Cross-cutting ----------
  telemetry_handler:
    type: git
    url: https://github.com/Equipe-eVTOL-ITA/telemetry_handler.git
    version: v0.1.1   # python3-tkinter -> python3-tk; opencv-python p/ o perfil

  # ---------- Layer 5: competition ----------
  sae2026:
    type: git
    url: https://github.com/Equipe-eVTOL-ITA/sae2026.git
    version: v0.1.0   # tagged from the jetson deployment branch

  cbr2026:
    type: git
    url: https://github.com/Equipe-eVTOL-ITA/cbr2026.git
    version: v0.3.1   # a fase 3 VOA
    # A v0.3.0 compila mas nao funciona: o config pedia
    # <camera_name>/image/compressed e o webcam_publisher publica em
    # <camera_name>_camera/compressed. O detector nunca recebia quadro, e o
    # drone giraria para sempre procurando uma mao que ninguem enxergava --
    # sem erro nenhum.
    #
    # A v0.3.0 acrescentou a fase 3, controle por gestos
    # A fase 3 tem arranjo DISTRIBUIDO: a camera fica no drone e a imagem
    # comprimida atravessa a rede ate o computador de solo, que roda o
    # reconhecimento de gestos e a FSM. Dai os quatro launches -- simulacao,
    # embarcado, solo e replay -- em vez dos dois da fase 1.
    #
    # A v0.2.0 e a fase 1 validada em voo
    # A v0.1.0 compila mas nao voa: reancora o referencial do mundo a cada
    # redecolagem e persegue a caixa mais central da imagem em vez da base
    # escolhida pela busca. O drone pousa na mesma base repetidamente e depois
    # vai e volta pela arena. Exige vision_geometry v0.1.1 e stdstates v0.2.1.
    #
    # Estava faltando neste manifesto embora ja fosse o repositorio de trabalho
    # da CBR: quem montasse o workspace so a partir daqui nao teria a fase 1 no
    # src/, e o `new_mission.sh` criaria fases num repositorio que o manifesto
    # nao conhece.
    #
    # E o unico consumidor de vision_geometry + stdstates + cv_nodes ao mesmo
    # tempo, entao o CI dele e o unico lugar onde um repin que quebre a missao
    # aparece. O CI de cada biblioteca prova que ELA compila, nao que a missao
    # continua compilando com ela.

  # ---------- External ROS 2 dependencies ----------
  behaviortree_cpp:
    type: git
    url: https://github.com/BehaviorTree/BehaviorTree.CPP.git
    version: "4.9.1"
    # DA FONTE, e nao do apt, porque o pacote apt esta QUEBRADO.
    #
    # O ros-humble-behaviortree-cpp 4.9.1 instala a biblioteca em
    # lib/x86_64-linux-gnu/ (layout multiarch do Debian) enquanto o
    # ament_cmake_export_libraries dele a procura em lib/. O resultado e que o
    # proprio find_package(behaviortree_cpp) aborta:
    #
    #     CMake Error at .../ament_cmake_export_libraries-extras.cmake:48
    #       Package 'behaviortree_cpp' exports the library 'behaviortree_cpp'
    #       which couldn't be found
    #
    # Verificado nas duas pontas: falha igual nesta maquina e no CI, e some ao
    # compilar da fonte, que instala em lib/ sem o subdiretorio de arquitetura.
    #
    # Compilar da fonte custa ~1min30s e resolve outra coisa de quebra: a
    # ambiguidade entre `behaviortree_cpp` (v4) e `behaviortree_cpp_v3` (v3),
    # cujos nomes convidam a instalar o errado.

  px4_msgs:
    type: git
    url: https://github.com/PX4/px4_msgs.git
    # A tag v1.15.4 aponta para o MESMO commit (a1045ec) para o qual o branch
    # release/1.15 aponta hoje — verificado. Trocar o branch pela tag não muda
    # um byte agora e impede que o pin ande sozinho quando a PX4 publicar
    # 1.15.5 no mesmo branch.
    version: v1.15.4        # casa com PX4-Autopilot v1.15.4 (SETUP.md)

  px4_ros2_interface:
    type: git
    url: https://github.com/Auterion/px4-ros2-interface-lib.git
    version: 1.3.0
    # Note o nome do diretório: o SETUP.md manda clonar este repo COMO
    # `px4_ros2_interface` (diferente do nome upstream), e é assim que ele
    # aparece em src/ nas máquinas do time. A chave acima preserva isso.
    #
    # Nenhum pacote do time declara dependência de `px4_ros2_cpp` hoje, mas o
    # repo `slam_bridge` (odometria visual -> PX4) depende dele. Ele estava
    # faltando neste manifesto embora o SETUP.md já mandasse cloná-lo — ou
    # seja, um workspace montado só a partir daqui não reproduzia a máquina
    # descrita no SETUP.md.
